{
  "name": "linkerhand-console-v2",
  "private": true,
  "version": "2.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:vision-assets && tsc -b && vite build",
    "build:windows": "pnpm tauri build --target x86_64-pc-windows-msvc",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:boundaries": "node scripts/check-boundaries-fixture.mjs",
    "typecheck": "tsc -b --pretty false",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:vision-assets": "node scripts/check-vision-assets.mjs",
    "vision:download": "node scripts/download-vision-assets.mjs",
    "test:sidecar:smoke": "python scripts/smoke-sidecar.py",
    "bundle:inventory": "node scripts/create-bundle-inventory.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@mediapipe/tasks-vision": "1.0.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "5.9.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-import": "latest",
    "eslint-plugin-react-hooks": "latest",
    "jsdom": "latest",
    "vitest": "latest",
    "@tauri-apps/cli": "^2.8.4"
  }
}
